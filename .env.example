# =====================================================================
# pescAPP · configuración. Copie este archivo como .env y ajuste.
# docker compose lee .env automáticamente; si no existe, usa estos
# mismos valores por defecto.
# =====================================================================

# --- Django ---
DJANGO_SECRET_KEY=cambie-esta-clave-solo-para-demo
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver

# --- PostgreSQL (fuente oficial) ---
POSTGRES_DB=pescapp
POSTGRES_USER=pescapp
POSTGRES_PASSWORD=pescapp
# Dentro de Docker el host es "postgres"; sin Docker use localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MongoDB (registro provisional del muelle) ---
# Dentro de Docker el host es "mongo"; sin Docker use localhost
MONGO_URI=mongodb://mongo:27017
MONGO_DB=pescapp

# --- Puertos publicados en el equipo anfitrión (solo 127.0.0.1) ---
# Se usan puertos poco comunes para no chocar con instalaciones locales.
WEB_PUERTO=8000
PG_PUERTO_HOST=5433
MONGO_PUERTO_HOST=27018
